						"---",
						"import WebMcpSearch from \"emdash/ui/webmcp-search\";",
						"---",
						"",
						"<WebMcpSearch",
						"  collections={[\"posts\", \"pages\"]}",
						"  routeMap={{ posts: \"/blog/:slug\" }}",
